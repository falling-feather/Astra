# 服务与浏览器配置
HOST=127.0.0.1
PORT=3001
DATA_DIR=.local/data
VITE_API_BASE_URL=
WEB_ALLOWED_ORIGINS=

# 本地向量推理采用单个工作队列；每批8条控制内存峰值。
RONGGANG_AI025_BATCH_SIZE=8

# 统一模型网关。普通开发、单元测试和 CI 默认 deterministic，不访问外网。
MODEL_PROVIDER=deterministic
MODEL_PROFILE_ID=deterministic-development
MODEL_TIMEOUT_MS=20000
MODEL_MAX_RETRIES=1

# DeepSeek V4 只作为短期 Live 测试提供方。密钥只写入未跟踪的 .env.local。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_LIVE_SMOKE=0

# 默认使用 mock，原型无需外部讯飞密钥即可完整运行。
IFLYTEK_MODE=mock

# 星辰智能体/工作流（Bearer）
# 官方工作流端点；TOKEN 采用 API_KEY:API_SECRET，服务端拼接 Bearer。
IFLYTEK_XINGCHEN_ENDPOINT=https://xingchen-api.xf-yun.com/workflow/v1/chat/completions
IFLYTEK_XINGCHEN_TOKEN=
IFLYTEK_XINGCHEN_WORKFLOW_ID=
IFLYTEK_RAG_ENDPOINT=
IFLYTEK_RAG_KNOWLEDGE_ID=

# 语音转写（HMAC-SHA1）
IFLYTEK_ASR_ENDPOINT=
IFLYTEK_ASR_APP_ID=
IFLYTEK_ASR_API_KEY=
IFLYTEK_ASR_API_SECRET=

# OCR（HMAC-SHA256）
IFLYTEK_OCR_ENDPOINT=
IFLYTEK_OCR_APP_ID=
IFLYTEK_OCR_API_KEY=
IFLYTEK_OCR_API_SECRET=

# 图片理解与内容审核（各能力由服务端专用 handler 完成签名）
IFLYTEK_IMAGE_ENDPOINT=
IFLYTEK_IMAGE_APP_ID=
IFLYTEK_IMAGE_API_KEY=
IFLYTEK_IMAGE_API_SECRET=
# 官方同步文本审核端点；签名与凭证只在专用 Handler 内构造，禁止记录完整 URL。
IFLYTEK_TEXT_MODERATION_ENDPOINT=https://audit.iflyaisol.com/audit/v2/syncText
IFLYTEK_IMAGE_MODERATION_ENDPOINT=
IFLYTEK_VIDEO_MODERATION_ENDPOINT=
IFLYTEK_MODERATION_APP_ID=
IFLYTEK_MODERATION_API_KEY=
IFLYTEK_MODERATION_API_SECRET=
# 发布候选默认在监听前完成恢复核验；需要测量后台恢复时再显式改为 background。
STARTUP_RECOVERY_MODE=blocking

# Set only after verifying that the selected provider accepts image input.
DEEPSEEK_VISION_MODEL=
SHOWCASE_DETERMINISTIC_STRUCTURED=0
