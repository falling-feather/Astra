    "ports": [
      {
        "id": "manifest",
        "owner": "CONTENT",
        "delivery": "CONTENT-005",
        "direction": "CONTENT -> FE",
        "minimum_contract": "immutable identity, canonical route, adapter id, versioned content, assessment/evidence declarations, resource budget and sources",
        "forbidden_authority": "network calls, release truth, completion truth and runtime-global registration"
      },
      {
        "id": "state-machine",
        "owner": "FE",
        "delivery": "ARCH-004 + FE-024/FE-025",
        "direction": "manifest + authority ports -> LearningActivity -> page owner",
        "minimum_contract": "one reserved runtime owner and the six lifecycle methods",
        "forbidden_authority": "invented release, completion, transfer or teacher facts"
      },
      {
        "id": "evidence",
        "owner": "FE+BE",
        "delivery": "shared client + BE-014",
        "direction": "page owner -> LearningActivity -> shared client -> endpoint -> service",
        "minimum_contract": "stable activity identity, client_event_id, rule version, immutable command+snapshot sidecar and learner/server cursor receipt",
        "forbidden_authority": "page/content direct API access and learner-emitted completed/transferred events"
      },
      {
        "id": "recovery",
        "owner": "BE",
        "delivery": "BE-014",
        "direction": "service projection -> shared client -> LearningActivity.restore",
        "minimum_contract": "authoritative scope, contiguous server history, separate offline learner sidecars, learner-bound snapshot, server-bound projection/witness and retry-safe identity",
        "forbidden_authority": "localStorage progress, route-derived completion or stale-account replay"
      },
      {
        "id": "evaluation",
        "owner": "FE+BE",
        "delivery": "FE-024/FE-025 + BE-014",
        "direction": "domain adapter -> formative feedback; trusted result -> service projection",
        "minimum_contract": "versioned rubric, bounded observation, feedback and explainable result",
        "forbidden_authority": "client feedback directly asserting authoritative completion"
      },
      {
        "id": "release",
        "owner": "BE",
        "delivery": "FE-023 consumes existing server authority",
        "direction": "release service -> publication context -> factory",
        "minimum_contract": "explicit class_id, course_id, unit_id and open/locked/hidden state",
        "forbidden_authority": "manifest defaults, URL shape or frontend fallback opening an activity"
      },
      {
        "id": "teacher-projection",
        "owner": "BE+FE",
        "delivery": "BE-015 -> FE-027",
        "direction": "evidence service -> bounded teacher facts -> teacher UI",
        "minimum_contract": "explicit class/course scope, generated_at, source event identity and bounded facts",
        "forbidden_authority": "teacher UI rescoring raw evidence or claiming mastery"
      }
    ],
    "team_boundaries": {
      "ARCH": {
        "may_own": [
          "contract schema",
          "dependency direction",
          "migration decisions",
          "machine gates"
        ],
        "must_not": [
          "implement FE or BE business behavior",
          "author course content",
          "change product truth while auditing"
        ]
      },
      "FE": {
        "may_own": [
          "browser runtime",
          "domain adapters",
          "shared client consumption",
          "accessible UI"
        ],
        "must_not": [
          "write evidence endpoints outside the shared client",
          "emit completed or transferred as learner events",
          "open locked or hidden content",
          "duplicate the LearningActivity global owner"
        ]
      },
      "BE": {
        "may_own": [
          "release authority",
          "evidence validation",
          "recovery projection",
          "authoritative evaluation",
          "teacher facts"
        ],
        "must_not": [
          "depend on browser or page modules",
          "render activity UI",
          "trust client-derived completion"
        ]
      },
      "CONTENT": {
        "may_own": [
          "manifest records",
          "versioned instructional content",
          "rubric references",
          "source provenance"
        ],
        "must_not": [
          "perform network calls",
          "register runtime globals",
          "declare release or completion truth",
          "embed credentials or student data"
        ]
      },
      "QA": {
        "may_own": [
          "contract fixtures",
          "failure baselines",
          "cross-layer acceptance evidence"
        ],
        "must_not": [
          "loosen allowlists to make a failure pass",
          "change product behavior during read-only acceptance",
          "replace an owning group implementation"
        ]
      }
    }
  },
