{
  "schema_version": 1,
  "purpose": "V8.2 EXT-01 copy-only scaffold for experiments that do not modify an existing owner",
  "required_files": [
    "manifest.json.tpl",
    "module.html.tpl",
    "index.js.tpl",
    "styles.css.tpl",
    "model-notes.md.tpl"
  ],
  "placeholders": [
    "__SUBJECT__",
    "__EXPERIMENT_ID__",
    "__EXPERIMENT_TITLE__",
    "__OWNER__",
    "__NAMESPACE__",
    "__ASSET_VERSION__",
    "__PARAMETER_LABEL__",
    "__PARAMETER_UNIT__",
    "__PRIMARY_LEGEND__",
    "__SECONDARY_LEGEND__",
    "__ACCENT_TOKEN__",
    "__ACCENT_RGB__"
  ],
  "copy_target": "pages/__SUBJECT__/__EXPERIMENT_ID__/",
  "production_registration": false,
  "rollback": "Remove the new catalog and runtime registration; the copied directory then has no reachable route.",
  "validation": "node tools/tests/new-experiment-template-contract.cjs",
  "registration_validation": "node tools/quality/check-new-experiment-registration.cjs --manifest <pages/subject/experiment/manifest.json>",
  "visual_contract": "visual-primitives.contract.json",
  "visual_validation": "node tools/tests/new-experiment-visual-primitives-contract.cjs",
  "model_contract": "model-document.contract.json",
  "model_example": "model-notes.example.md",
  "model_validation": "node tools/quality/check-new-experiment-model-document.cjs --manifest <pages/subject/experiment/manifest.json>"
}
